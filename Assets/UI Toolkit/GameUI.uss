:root {
}

.pause-button:hover {
    background-color: rgb(0, 157, 255);
}

.pause-button {
    width: 100%;
    height: 8%;
    -unity-font-definition: url("project://database/Assets/Fonts/techno_hideo_bold.ttf?fileID=12800000&guid=01fa644f4914c34499505265d7bb0093&type=3#techno_hideo_bold");
    font-size: 50px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-duration: 0.3s;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}
